# Settings of dicta-action-server for `npm run server`. Copy this file to .env
# and fill it in. Never commit .env: it holds your keys.

# The planner: claude.
PLANNER=claude

# Your key for the Claude API.
ANTHROPIC_API_KEY=

# The Claude model and how much it thinks: low, medium, high, xhigh or max.
# Leave them out for the defaults.
# PLANNER_CLAUDE_MODEL=claude-opus-5-5
# PLANNER_CLAUDE_EFFORT=medium

# The secret for the tokens, at least 32 bytes. Your site's token endpoint
# uses the same secret.
JWT_SECRET=

# true turns the token check off. Only for tests on your own machine.
# ALLOW_UNAUTHENTICATED=true

# The most plans for one request, 1 to 20. Default 10.
# MAX_PLANS=10

# The port the server listens on.
PORT=8080
